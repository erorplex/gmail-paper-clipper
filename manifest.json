{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "Paper Clipper",
  "version": "0.1.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "clipboardWrite",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/mime.js",
        "src/format.js",
        "src/store.js",
        "src/gmail.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
